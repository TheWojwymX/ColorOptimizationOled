#pragma kernel CSMain

Texture2D<float4> Input;
RWTexture2D<float4> Result;

[numthreads(8,8,1)]
void CSMain(uint3 id : SV_DispatchThreadID)
{
    uint w, h;
    Result.GetDimensions(w, h);

    if (id.x >= w || id.y >= h)
        return;

    float4 col = Input[id.xy];

    col.rgb = float3(1, 0, 0);

    Result[id.xy] = col;
}